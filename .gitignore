# Build caches can appear inside vendored Flutter plugins too.
**/.cxx/
**/CMakeFiles/
**/CMakeCache.txt
**/compile_commands.json
**/.ninja_deps
**/.ninja_log

# Python service local environments and caches.
**/.venv/
**/__pycache__/
**/.pytest_cache/

# Vendored plugin examples are useful locally, but not required by path deps.
third_party/*/example/
AGENTS.md

# Local AI/tool settings may contain machine paths or credentials.
.claude/

# Firebase project-specific configuration. Generate with FlutterFire CLI.
firebase.json
lib/firebase_options.dart
**/google-services.json
**/GoogleService-Info.plist

# Local build-time configuration.
config/dart_defines.json
**/Flutter/Secrets.xcconfig

# SwiftPM/Xcode per-user state.
**/.swiftpm/**/xcuserdata/
